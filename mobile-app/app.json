{
  "expo": {
    "name": "Servon",
    "slug": "servon-business",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/servon-logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF9F6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.servon.business"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF9F6"
      },
      "package": "com.servon.business",
      "permissions": [
        "NOTIFICATIONS",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "name": "Servon | Track Your Business",
      "shortName": "Servon",
      "description": "The premium operating system for high-growth Indian restaurants.",
      "backgroundColor": "#FAF9F6",
      "themeColor": "#008060",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "cc595fcc-0f57-4242-a498-bb317bd6a582"
      }
    },
    "owner": "servon",
    "plugins": [
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Servon to use your microphone for Voice AI Business Advisor."
        }
      ],
      "expo-asset",
      "expo-font"
    ]
  }
}
